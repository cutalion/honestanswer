.question
  %h1= @question.text
  .author
    = gravatar_for @question.author
    .name= @question.author.name
- set_meta_tags :title => @question.text

.answers= render @question.answers

= simple_form_for [@question, @answer], :remote => true do |f|
  = f.input_field :text, :label => false, :placeholder => 'Leave your answer, be honest', :tabindex => 1
  = f.submit 'Answer', :disable_with => 'Sending...'

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    const consumer = ActionCable.createConsumer();

    consumer.subscriptions.create(
      { channel: "AnswerChannel", question_id: #{@question.id} },
      {
        received(data) {
          const answersContainer = document.querySelector('.answers');
          if (answersContainer) {
            answersContainer.insertAdjacentHTML('beforeend', data.answer_html);
            // Re-initialize timeago for any new elements
            if (typeof jQuery !== 'undefined' && typeof jQuery.timeago !== 'undefined') {
              jQuery('.timeago').timeago();
            }
          }
        }
      }
    );
  });
